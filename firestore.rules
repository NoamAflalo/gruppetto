rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isGlobalAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // Profiles: readable by signed-in users (no emails stored here),
    // writable only by their owner.
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    // Settings: private to their owner.
    match /settings/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Recurring session templates: host-only in every direction. Nobody
    // else needs to read these — the "repeats every X" badge is derived
    // client-side from each generated session's own date, and only the
    // host manages the series (start/stop). No hard delete: stopping a
    // series sets active=false so history and any already-generated future
    // occurrences stay intact; only the daily cron (admin SDK, bypasses
    // these rules) reads active templates to generate new occurrences.
    match /recurringSessions/{recurringId} {
      allow read: if signedIn() && resource.data.host_user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.host_user_id == request.auth.uid;
      allow update: if signedIn()
        && resource.data.host_user_id == request.auth.uid
        && request.resource.data.host_user_id == resource.data.host_user_id;
      allow delete: if false;
    }

    match /sessions/{sessionId} {

      function changedOnly(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      function isHost() {
        return resource.data.host_user_id == request.auth.uid;
      }

      // Adding exactly yourself to participants — public sessions only,
      // and girls-only sessions require a female profile.
      function joining() {
        return changedOnly(['participants'])
          && request.resource.data.participants.hasAll(resource.data.participants)
          && request.resource.data.participants.size() == resource.data.participants.size() + 1
          && request.auth.uid in request.resource.data.participants
          && !(request.auth.uid in resource.data.participants)
          && resource.data.isPrivate != true
          && (resource.data.girlsOnly != true
              || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.gender == 'female');
      }

      // Removing exactly yourself from participants.
      function leaving() {
        return changedOnly(['participants'])
          && resource.data.participants.hasAll(request.resource.data.participants)
          && request.resource.data.participants.size() == resource.data.participants.size() - 1
          && request.auth.uid in resource.data.participants
          && !(request.auth.uid in request.resource.data.participants);
      }

      // Appending exactly one join request, for yourself.
      function requestingJoin() {
        return changedOnly(['joinRequests'])
          && request.resource.data.joinRequests.size() == resource.data.get('joinRequests', []).size() + 1
          && request.resource.data.joinRequests[request.resource.data.joinRequests.size() - 1].userId == request.auth.uid;
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.host_user_id == request.auth.uid
        && request.resource.data.participants == [request.auth.uid];

      // Host edits their session (but can't reassign ownership).
      // Everyone else can only join, leave, or file a join request.
      allow update: if signedIn() && (
        (isHost() && request.resource.data.host_user_id == resource.data.host_user_id)
        || joining()
        || leaving()
        || requestingJoin()
      );

      allow delete: if signedIn() && (isHost() || isGlobalAdmin());

      // Chat: participants only. Authors edit/delete their messages;
      // any signed-in user may append themselves to readBy (read receipts).
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participants;
        allow update: if signedIn() && (
          resource.data.userId == request.auth.uid
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
              && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
              && request.auth.uid in request.resource.data.readBy)
        );
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // Clubs: unchanged from the original console rules.
    match /clubs/{clubId} {
      allow read: if signedIn() && (
        resource.data.status == 'approved' ||
        resource.data.founder_id == request.auth.uid ||
        isGlobalAdmin()
      );

      allow create: if signedIn()
        && request.resource.data.founder_id == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if signedIn() && (
        request.auth.uid in resource.data.admins ||
        isGlobalAdmin()
      );

      allow delete: if signedIn() && (
        request.auth.uid == resource.data.founder_id ||
        isGlobalAdmin()
      );
    }
  }
}
